# 直连本地或未加闸的上游（WS_HOST 填站点 origin，不要带 /ws 路径）
API_HOST=http://your-nezha-host:8080
WS_HOST=http://your-nezha-host:8080
# v0 页面抓取才需要
NEZHA_HOST=http://your-nezha-host:8080

# 不走 Cloudflare Access 时，可用 WS 中继（与 CF Access 互斥）
# PROXY_WS_HOST=http://127.0.0.1:9288

# 哪吒 / 三太子版本：v0 | v1 | santaizi
# VITE_NEZHA_VERSION=santaizi

# Cloudflare Zero Trust（dash.cvm.im 等）
# Access 应用需单独一条 Action = Service Auth 的策略
# 配置后会忽略 PROXY_WS_HOST
# API_HOST=https://dash.cvm.im
# WS_HOST=https://dash.cvm.im
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
# 尚未开 Service Auth 时的备选：
# CF_AUTHORIZATION=
